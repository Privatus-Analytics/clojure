{:paths ["src"]
 :deps {org.clojure/clojure {:mvn/version "1.11.4"}}
 :aliases
 {;; clojure -X:test
  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                      hiccup/hiccup {:mvn/version "2.0.0"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  ;; clojure -M:1.12:test runs the tests on Clojure 1.12
  :1.12 {:override-deps {org.clojure/clojure {:mvn/version "1.12.6"}}}
  ;; clojure -M:lint
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2026.10.20"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test" "build.clj"]}
  ;; clojure -M:fmt check   (or fix)
  :fmt {:replace-deps {dev.weavejester/cljfmt {:mvn/version "0.16.6"}}
        :main-opts ["-m" "cljfmt.main"]}
  ;; clojure -T:build jar   /   clojure -T:build deploy
  :build {:deps {io.github.clojure/tools.build {:mvn/version "0.10.14"}
                 slipset/deps-deploy {:mvn/version "0.2.5"}}
          :ns-default build}}}
